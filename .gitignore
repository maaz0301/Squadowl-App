android/.gradle/
android/.idea/
android/local.properties
android/build/
android/app/build/
android/app/.cxx/
android/captures/
*.hprof

ios/build/
ios/Pods/
ios/.xcode.env.local
ios/DerivedData/
*.xcuserdatad
xcuserdata/

